NODE_ENV=development
PORT=3000
PUBLIC_API_URL=https://api.9jasingles.app
ADMIN_PHONE=

DATABASE_URL=postgres://9ja:9ja@localhost:5432/9jasingles
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
OTP_TTL_SECONDS=300
MAX_ACCOUNTS_PER_DEVICE=2

# One identity, one account (salt for hashing NIN / passport numbers)
IDENTITY_HASH_SALT=change-me-long-random

# SMS OTP
TERMII_API_KEY=
TERMII_SENDER_ID=9jaSingles
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Identity verification
SMILEID_PARTNER_ID=
SMILEID_API_KEY=
SMILEID_BASE_URL=https://testapi.smileidentity.com/v1
DOJAH_APP_ID=
DOJAH_SECRET_KEY=
DOJAH_BASE_URL=https://sandbox.dojah.io

# Media storage (Cloudflare R2 or AWS S3)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=9jasingles-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CDN_BASE_URL=

# Photo / content moderation provider
MODERATION_API_URL=
MODERATION_API_KEY=

# Payments
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=https://9jasingles.app/payment/callback

# Push (Expo push service -> FCM + APNs)
EXPO_ACCESS_TOKEN=
